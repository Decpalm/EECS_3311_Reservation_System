@startuml
title Singleton Pattern - ReservationSystem and CSVDataStore

skinparam classAttributeIconSize 0
skinparam shadowing false

class ReservationSystem <<Singleton>> {
  - instance: ReservationSystem
  - dataStore: CSVDataStore
  - ReservationSystem()
  + getInstance(): ReservationSystem
  + registerUser(...): User
  + createReservation(...): Reservation
  + modifyReservation(...): void
  + cancelReservation(...): void
  + extendReservation(...): void
  + processPayment(...): Payment
  + addEquipment(...): Equipment
  + updateEquipmentStatus(...): void
  + applySensorUpdate(...): void
  + autoGenerateLabManager(...): void
}

class CSVDataStore <<Singleton>> {
  - instance: CSVDataStore
  - users: List<User>
  - equipmentList: List<Equipment>
  - reservations: List<Reservation>
  - payments: List<Payment>
  - CSVDataStore()
  + getInstance(): CSVDataStore
}

ReservationSystem --> CSVDataStore : uses
@enduml
