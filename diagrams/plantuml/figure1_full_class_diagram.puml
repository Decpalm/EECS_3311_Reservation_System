@startuml
title YorkU Lab Equipment Reservation Platform - Updated Class Diagram

skinparam classAttributeIconSize 0
skinparam shadowing false
skinparam linetype ortho

' =========================
' Core Domain Model
' =========================

abstract class User {
  - userId: UUID
  - email: String
  - passwordHash: String
  - status: String
  - idOrCertNumber: String
  + getHourlyRate(): double
  + isActive(): boolean
}

class Student {
  + getHourlyRate(): double
}

class Faculty {
  + getHourlyRate(): double
}

class Researcher {
  + getHourlyRate(): double
}

class Guest {
  + getHourlyRate(): double
}

class HeadLabCoordinator {
  - coordinatorId: String
  + autoGenerateManagerAccount(email: String): LabManager
}

class LabManager {
  - managerId: String
  + addEquipment(equipment: Equipment): void
  + setEquipmentStatus(equipment: Equipment, status: String): void
  + markMaintenance(equipment: Equipment): void
}

class Equipment {
  - equipmentId: String
  - description: String
  - labLocation: String
  - status: String
  + enable(): void
  + disable(): void
  + markMaintenance(): void
  + isAvailable(start: LocalDateTime, end: LocalDateTime): boolean
}

class Reservation {
  - reservationId: UUID
  - startTime: LocalDateTime
  - endTime: LocalDateTime
  - status: String
  - hourlyRate: double
  - depositAmount: double
  - totalCost: double
  + checkTime(): LocalDateTime[0..1]
  + calculateTotalCost(): void
  + modifyReservation(newStartTime: LocalDateTime, newEndTime: LocalDateTime): void
  + cancelReservation(currentTime: LocalDateTime): boolean
  + extendReservation(additionalMinutes: int): boolean
  + recordArrival(arrivalTime: LocalDateTime): void
  + isNoShow(): boolean
  + calculateRemainingBalance(): double
}

class Payment {
  - paymentId: UUID
  - amount: double
  - time: LocalDateTime
  - method: String
  - type: String
  - status: String
  + markSuccess(): void
  + markFailed(): void
  + refund(): void
}

class ApprovalRequest {
  - requestId: UUID
  - submittedAt: LocalDateTime
  - status: String
  + approve(): void
  + reject(): void
}

class DepartmentApprover {
  - approverId: String
  + review(request: ApprovalRequest, decision: String): void
}

class SensorUpdate {
  - updateId: UUID
  - timestamp: LocalDateTime
  - operationalStatus: String
  - message: String
}

User <|-- Student
User <|-- Faculty
User <|-- Researcher
User <|-- Guest

User <|-- HeadLabCoordinator
User <|-- LabManager

User "1" --> "0..*" Reservation : makes
Equipment "1" --> "0..*" Reservation : reserved for
Reservation "1" *-- "1..*" Payment : contains
User "1" --> "0..1" ApprovalRequest : submits
DepartmentApprover "1" --> "0..*" ApprovalRequest : reviews
Equipment "1" *-- "1..*" SensorUpdate : receives

' =========================
' Singleton Pattern
' =========================

class ReservationSystem <<Singleton>> {
  - instance: ReservationSystem
  - ReservationSystem()
  + getInstance(): ReservationSystem
  + registerUser(...): User
  + reserveEquipment(...): Reservation
  + modifyBooking(...): void
  + cancelBooking(...): void
  + extendBooking(...): void
  + processPayment(...): Payment
}

class CSVDataStore <<Singleton>> {
  - instance: CSVDataStore
  - CSVDataStore()
  + getInstance(): CSVDataStore
  + saveUser(user: User): void
  + saveReservation(reservation: Reservation): void
  + saveEquipment(equipment: Equipment): void
  + savePayment(payment: Payment): void
  + loadUsers(): List<User>
  + loadReservations(): List<Reservation>
  + loadEquipment(): List<Equipment>
}

ReservationSystem --> CSVDataStore : uses

' =========================
' Factory Pattern
' =========================

class AccountFactory <<Factory>> {
  + createUser(type: String, email: String, passwordHash: String, idOrCertNumber: String): User
  + createLabManager(email: String): LabManager
}

class EquipmentFactory <<Factory>> {
  + createEquipment(description: String, labLocation: String): Equipment
}

ReservationSystem --> AccountFactory : uses
ReservationSystem --> EquipmentFactory : uses
AccountFactory ..> User : creates
EquipmentFactory ..> Equipment : creates

' =========================
' Strategy Pattern
' =========================

interface PricingStrategy <<Strategy>> {
  + calculateHourlyRate(user: User): double
  + calculateDeposit(user: User, hours: double): double
  + calculateTotal(user: User, hours: double): double
}

class StudentPricingStrategy {
  + calculateHourlyRate(user: User): double
  + calculateDeposit(user: User, hours: double): double
  + calculateTotal(user: User, hours: double): double
}

class FacultyPricingStrategy {
  + calculateHourlyRate(user: User): double
  + calculateDeposit(user: User, hours: double): double
  + calculateTotal(user: User, hours: double): double
}

class ResearcherPricingStrategy {
  + calculateHourlyRate(user: User): double
  + calculateDeposit(user: User, hours: double): double
  + calculateTotal(user: User, hours: double): double
}

class GuestPricingStrategy {
  + calculateHourlyRate(user: User): double
  + calculateDeposit(user: User, hours: double): double
  + calculateTotal(user: User, hours: double): double
}

PricingStrategy <|.. StudentPricingStrategy
PricingStrategy <|.. FacultyPricingStrategy
PricingStrategy <|.. ResearcherPricingStrategy
PricingStrategy <|.. GuestPricingStrategy

Reservation --> PricingStrategy : uses
ReservationSystem --> PricingStrategy : selects

' =========================
' Observer Pattern
' =========================

interface EquipmentObserver <<Observer>> {
  + update(equipment: Equipment): void
}

interface EquipmentSubject {
  + attach(observer: EquipmentObserver): void
  + detach(observer: EquipmentObserver): void
  + notifyObservers(): void
}

Equipment ..|> EquipmentSubject

class LabManagerDashboard {
  + update(equipment: Equipment): void
}

class NotificationService {
  + update(equipment: Equipment): void
  + sendMaintenanceAlert(equipment: Equipment): void
  + sendStatusAlert(equipment: Equipment): void
}

EquipmentObserver <|.. LabManagerDashboard
EquipmentObserver <|.. NotificationService

Equipment "1" --> "0..*" EquipmentObserver : notifies
SensorUpdate --> Equipment : updates status

' =========================
' Command Pattern
' =========================

interface Command <<Command>> {
  + execute(): void
}

class ReserveEquipmentCommand {
  - system: ReservationSystem
  + execute(): void
}

class ModifyBookingCommand {
  - system: ReservationSystem
  + execute(): void
}

class CancelBookingCommand {
  - system: ReservationSystem
  + execute(): void
}

class ExtendBookingCommand {
  - system: ReservationSystem
  + execute(): void
}

class AddEquipmentCommand {
  - system: ReservationSystem
  + execute(): void
}

class UpdateEquipmentStatusCommand {
  - system: ReservationSystem
  + execute(): void
}

class GUIController {
  + submit(command: Command): void
}

Command <|.. ReserveEquipmentCommand
Command <|.. ModifyBookingCommand
Command <|.. CancelBookingCommand
Command <|.. ExtendBookingCommand
Command <|.. AddEquipmentCommand
Command <|.. UpdateEquipmentStatusCommand

GUIController --> Command : triggers
ReserveEquipmentCommand --> ReservationSystem
ModifyBookingCommand --> ReservationSystem
CancelBookingCommand --> ReservationSystem
ExtendBookingCommand --> ReservationSystem
AddEquipmentCommand --> ReservationSystem
UpdateEquipmentStatusCommand --> ReservationSystem

' =========================
' State Pattern
' =========================

interface EquipmentState <<State>> {
  + enable(equipment: Equipment): void
  + disable(equipment: Equipment): void
  + markMaintenance(equipment: Equipment): void
}

class AvailableState
class DisabledState
class MaintenanceState

EquipmentState <|.. AvailableState
EquipmentState <|.. DisabledState
EquipmentState <|.. MaintenanceState

Equipment --> EquipmentState : currentState

interface ReservationState <<State>> {
  + modify(reservation: Reservation): void
  + cancel(reservation: Reservation): void
  + extend(reservation: Reservation): void
}

class PendingState
class ConfirmedState
class ExtendedState
class CancelledState

ReservationState <|.. PendingState
ReservationState <|.. ConfirmedState
ReservationState <|.. ExtendedState
ReservationState <|.. CancelledState

Reservation --> ReservationState : currentState

@enduml
