@startuml
title YorkU Lab Equipment Reservation Platform - Simplified Full Class Diagram

skinparam classAttributeIconSize 0
skinparam shadowing false
skinparam linetype ortho

package "Presentation Layer" {
  class GUIController
}

package "Application Layer" {
  class ReservationSystem <<Singleton>>
  class CSVDataStore <<Singleton>>
  class AccountFactory <<Factory>>
  class EquipmentFactory <<Factory>>

  interface Command <<Command>>
  class ReserveEquipmentCommand
  class ModifyBookingCommand
  class CancelBookingCommand
  class ExtendBookingCommand
  class AddEquipmentCommand
  class UpdateEquipmentStatusCommand

  Command <|.. ReserveEquipmentCommand
  Command <|.. ModifyBookingCommand
  Command <|.. CancelBookingCommand
  Command <|.. ExtendBookingCommand
  Command <|.. AddEquipmentCommand
  Command <|.. UpdateEquipmentStatusCommand

  GUIController --> Command : submits
  ReserveEquipmentCommand --> ReservationSystem
  ModifyBookingCommand --> ReservationSystem
  CancelBookingCommand --> ReservationSystem
  ExtendBookingCommand --> ReservationSystem
  AddEquipmentCommand --> ReservationSystem
  UpdateEquipmentStatusCommand --> ReservationSystem

  ReservationSystem --> CSVDataStore : uses
  ReservationSystem ..> AccountFactory : uses
  ReservationSystem ..> EquipmentFactory : uses
}

package "Domain Model" {
  abstract class User {
    userId: UUID
    email: String
    status: String
  }

  class Student
  class Faculty
  class Researcher
  class Guest
  class HeadLabCoordinator
  class LabManager

  User <|-- Student
  User <|-- Faculty
  User <|-- Researcher
  User <|-- Guest
  User <|-- HeadLabCoordinator
  User <|-- LabManager

  class Equipment {
    equipmentId: String
    description: String
    labLocation: String
    status: String
    currentState: EquipmentState
  }

  class Reservation {
    reservationId: UUID
    startTime: LocalDateTime
    endTime: LocalDateTime
    status: String
    pricingStrategy: PricingStrategy
    currentState: ReservationState
    payment: Payment
  }

  class Payment {
    amount: double
    method: String
    status: String
  }

  class SensorUpdate {
    operationalStatus: String
    message: String
  }

  User "1" --> "0..*" Reservation : places
  Reservation "1" --> "1" User : reservedBy
  Reservation "1" --> "1" Equipment : reservedItem
  Reservation "1" *-- "0..1" Payment : owns
  LabManager --> "0..*" Equipment : manages
  HeadLabCoordinator ..> LabManager : creates
  SensorUpdate ..> Equipment : updates
}

package "Strategy Pattern" {
  interface PricingStrategy <<Strategy>>
  class StudentPricingStrategy
  class FacultyPricingStrategy
  class ResearcherPricingStrategy
  class GuestPricingStrategy

  PricingStrategy <|.. StudentPricingStrategy
  PricingStrategy <|.. FacultyPricingStrategy
  PricingStrategy <|.. ResearcherPricingStrategy
  PricingStrategy <|.. GuestPricingStrategy

  Reservation --> PricingStrategy : uses
}

package "Observer Pattern" {
  interface EquipmentObserver <<Observer>>
  interface EquipmentSubject

  class LabManagerDashboard
  class NotificationService

  Equipment ..|> EquipmentSubject
  LabManagerDashboard ..|> EquipmentObserver
  NotificationService ..|> EquipmentObserver

  Equipment --> "0..*" EquipmentObserver : notifies
}

package "State Pattern" {
  interface EquipmentState <<State>>
  class AvailableState
  class DisabledState
  class MaintenanceState

  EquipmentState <|.. AvailableState
  EquipmentState <|.. DisabledState
  EquipmentState <|.. MaintenanceState

  interface ReservationState <<State>>
  class PendingState
  class ConfirmedState
  class ExtendedState
  class CancelledState

  ReservationState <|.. PendingState
  ReservationState <|.. ConfirmedState
  ReservationState <|.. ExtendedState
  ReservationState <|.. CancelledState

  Equipment --> EquipmentState : currentState
  Reservation --> ReservationState : currentState
}

@enduml
