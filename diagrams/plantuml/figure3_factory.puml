@startuml
title Factory Method Pattern - Account and Equipment Creation

skinparam classAttributeIconSize 0
skinparam shadowing false

abstract class User {
  - userId: UUID
  - email: String
  - passwordHash: String
  - status: String
  - idOrCertNumber: String
  + getHourlyRate(): double
}

class Student
class Faculty
class Researcher
class Guest
class LabManager

class Equipment {
  - equipmentId: String
  - description: String
  - labLocation: String
  - status: String
}

class AccountFactory <<Factory>> {
  + createUser(type: String, email: String, passwordHash: String, idOrCertNumber: String): User
  + createLabManager(email: String): LabManager
}

class EquipmentFactory <<Factory>> {
  + createEquipment(description: String, labLocation: String): Equipment
}

User <|-- Student
User <|-- Faculty
User <|-- Researcher
User <|-- Guest
User <|-- LabManager

AccountFactory ..> User : creates
EquipmentFactory ..> Equipment : creates
@enduml
